# GENERATED BY sparkyard — DO NOT EDIT. Edit models.yaml + `make render`.
general_settings:
  master_key: "os.environ/LITELLM_MASTER_KEY"
  ui_username: "os.environ/LITELLM_UI_USERNAME"
  ui_password: "os.environ/LITELLM_UI_PASSWORD"
  ui_access_mode: "admin_only"
  disable_master_key_return: true
  allow_model_creation: false

model_list:
{%- for m in models %}
{%- for served in m.served_names %}
  - model_name: {{ served }}
    litellm_params:
      model: openai/{{ m.name }}
      api_base: "http://llama-swap:8080/v1"
      api_key: "os.environ/LITELLM_MASTER_KEY"
{%- for key, value in m.litellm.items() %}
      {{ key }}: {{ value | tojson }}
{%- endfor %}
{%- endfor %}
{%- endfor %}

litellm_settings:
  drop_params: true
  # Claude Code talks to the gateway over Anthropic /v1/messages. LiteLLM's
  # default bridge for openai/ deployments is the OpenAI Responses API, whose
  # adapter emits input_image items without the `detail` field that vLLM's
  # Responses schema requires: an agent reading an image it generated got a 400.
  # The chat/completions route hoists tool-result images into a user message
  # and also surfaces reasoning as thinking blocks (2026-09-24).
  use_chat_completions_url_for_anthropic_messages: true
  set_verbose: false
  request_timeout: {{ request_timeout }}
  merge_reasoning_content_in_choices: true
  stream: true
  health_check_interval: 0
  num_retries: 0
  fallbacks: []
